{
  "name": "@legallabs/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "legallabs-admin": "./dist/cli.js",
    "legallabs-knowledge": "./dist/knowledge/cli.js",
    "legallabs-runs-worker": "./dist/runs-worker.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "openapi:write": "tsc -p tsconfig.build.json && node dist/public-api/openapi-cli.js --write",
    "openapi:check": "node dist/public-api/openapi-cli.js --check",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@legallabs/citations": "workspace:*",
    "@legallabs/contracts": "workspace:*",
    "@legallabs/db": "workspace:*",
    "@legallabs/docx": "workspace:*",
    "@legallabs/embed": "workspace:*",
    "@legallabs/ingest": "workspace:*",
    "@legallabs/knowledge": "workspace:*",
    "@legallabs/model-gateway": "workspace:*",
    "@legallabs/review": "workspace:*",
    "@legallabs/runs": "workspace:*",
    "@legallabs/storage": "workspace:*",
    "@legallabs/workflows": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.1.0",
    "fflate": "0.8.3",
    "hono": "4.13.17",
    "jose": "6.2.18",
    "nodemailer": "10.4.1",
    "pg": "8.23.1",
    "postal-mime": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "aws4fetch": "1.0.20",
    "vitest": "5.1.0"
  }
}
