{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "PG_BIN"]
    },
    "@legallabs/api#test": {
      "dependsOn": ["^build", "@legallabs/db#test"],
      "env": ["TEST_DATABASE_URL", "PG_BIN"]
    }
  }
}
